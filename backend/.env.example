# ============================================
# Pathwise Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# --- AI Provider (gemini OR openai) ---
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# --- API Keys (fill at least one) ---
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# --- App Security ---
SECRET_KEY=your-super-secret-key-change-this

# --- Database ---
# For Railway: Use Railway's PostgreSQL addon URL (they give you DATABASE_URL automatically)
# For SQLite (local only):
DATABASE_URL=sqlite:///./pathwise.db

# --- File Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,ppt,pptx

# --- CORS: Set this to your Vercel frontend URL after deployment ---
FRONTEND_URL=https://your-app.vercel.app
